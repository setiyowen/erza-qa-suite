# Erza QA Suite credentials
#
# AUTO-LOGIN BEHAVIOR:
#   - Playwright signs in with ERZA_EMAIL + ERZA_PASSWORD
#   - If the account does not exist / password is wrong, it AUTO SIGNS UP
#     via /api/auth/sign-up/email, then signs in
#   - If sign-up is blocked by the backend domain allowlist (HTTP 422
#     "Email not allowed"), the run fails with a clear message — use an
#     email from an allowed domain or an existing account
#
ERZA_EMAIL=dodihomeless@web-library.net
ERZA_PASSWORD=

# Optional overrides
# ERZA_BASE_URL=https://dev.erza.ai
# SESSION=<better-auth.session_token cookie, optional pre-authenticated session>
# ERZA_PASSWORD_HINT=  # (informational only, not used by the suite)
